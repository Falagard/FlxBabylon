-main ApplicationMain 
-cp C:/Src/ge/flixel
-D flixel=6.0.0
--macro openfl.utils._internal.ExtraParamsMacro.include()
-cp C:/Src/ge/openfl/src
-D openfl=9.4.1
--macro lime._internal.macros.DefineMacro.run()
-cp C:/Src/ge/lime/src
-D lime=8.2.2
--macro keep('IntIterator')
-cp C:/HaxeToolkit/haxe/lib/hscript/2,6,0
-D hscript=2.6.0
-cp C:/Src/ge/centauri
-D centauri=0.0.0
-cp C:/Src/ge/BabylonHx
-D BabylonHx=0.0.0
-cp source
-D lime-openal
-D message.reporting=pretty
-D native
-D lime-opengles
-D lime-curl
-D openfl-native
-D openfl-disable-handle-error
-D FLX_NO_HEALTH
-D lime-harfbuzz
-D lime-threads
-D tools=8.2.2
-D lime-cairo
-D no-compilation
-D FLX_NO_TOUCH
-D lime-native
-D lime-vorbis
-D lime-cffi
-D windows
-D desktop
--remap flash:openfl
--macro flixel.system.macros.FlxDefines.run()
--connect
6000
-cp export/hl/haxe
-hl export/hl/obj/ApplicationMain.hl
--macro keep("Main")
-D final